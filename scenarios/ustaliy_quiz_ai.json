{
  "name": "USTALIY.ru: тест на эрудицию (AI ответы)",
  "description": "Открывает тест, затем 20 раз просит AI выбрать правильный ответ и нажимает 'Следующий вопрос'.",
  "version": "1.0",
  "steps": [
    {
      "action": "navigate",
      "url": "https://ustaliy.ru/snax_quiz/ezhednevnyy-test-na-eruditsiyu-ot-16-yanvarya-2026/"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "click",
      "selector": "Пройти тест",
      "method": "text"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "repeat",
      "type": "count",
      "times": 20,
      "steps": [
        {
          "action": "ai_decide",
          "prompt": "Выбери правильный ответ.",
          "context_selector": "h2",
          "context_method": "css",
          "options_selector": "input[name^='snax_question_']",
          "options_method": "css",
          "click_selector": "input[name^='snax_question_']",
          "click_method": "css"
        },
        {
          "action": "wait",
          "seconds": 1
        },
        {
          "action": "click",
          "selector": "Следующий вопрос",
          "method": "text"
        },
        {
          "action": "wait",
          "seconds": 1
        }
      ]
    }
  ]
}
