{
  "name": "Вход в аккаунт larnes.ru",
  "description": "Простой сценарий входа в аккаунт. ВАЖНО: Нужно заменить селекторы на правильные для вашей страницы!",
  "version": "1.0",
  "steps": [
    {
      "action": "navigate",
      "url": "https://larnes.ru/login"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "type",
      "selector": "#identifier",
      "method": "css",
      "value": "qwerqwer"
    },
    {
      "action": "type",
      "selector": "#password",
      "method": "css",
      "value": "qwer1234"
    },
    {
      "action": "click",
      "selector": "Войти",
      "method": "text"
    }
  ]
}
