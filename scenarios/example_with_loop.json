{
  "name": "Обработка списка элементов",
  "description": "Пример сценария с циклом для обработки элементов",
  "version": "1.0",
  "steps": [
    {
      "action": "navigate",
      "url": "https://example.com/list"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "repeat",
      "type": "until_stopped",
      "steps": [
        {
          "action": "click",
          "selector": ".item:first",
          "method": "css"
        },
        {
          "action": "wait",
          "seconds": 1
        },
        {
          "action": "get_text",
          "selector": ".content",
          "method": "css"
        },
        {
          "action": "click",
          "selector": "Готово",
          "method": "text"
        },
        {
          "action": "wait",
          "seconds": 1
        },
        {
          "action": "navigate",
          "url": "back"
        },
        {
          "action": "wait",
          "seconds": 1
        }
      ]
    }
  ]
}
