{
  "name": "OnlineTestPad: тест по программированию (AI ответы)",
  "description": "Открывает тест, затем 49 раз выбирает ответ и нажимает 'Далее'.",
  "version": "1.0",
  "steps": [
    {
      "action": "navigate",
      "url": "https://onlinetestpad.com/ru/test/54593-test-po-programmirovaniyu"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "click",
      "selector": "#btnNext",
      "method": "css"
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "repeat",
      "type": "count",
      "times": 49,
      "steps": [
        {
          "action": "ai_decide",
          "prompt": "Выбери правильный ответ.",
          "context_selector": "span.qtext",
          "context_method": "css",
          "options_selector": "#d-q-ans-container span",
          "options_method": "css",
          "click_selector": "#d-q-ans-container label",
          "click_method": "css",
          "max_retries": 1
        },
        {
          "action": "wait",
          "seconds": 1
        },
        {
          "action": "click",
          "selector": "#btnNext",
          "method": "css"
        },
        {
          "action": "wait",
          "seconds": 1
        }
      ]
    }
  ]
}
